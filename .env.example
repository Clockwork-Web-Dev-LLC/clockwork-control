APP_NAME="Clockwork Control"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clockwork
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# When ready to actually send customer notifications (contact-form-test failed/
# recovered emails + monthly summaries + vulnerability reports), flip
# MAIL_MAILER=mailgun and fill in the block below. Then:
#     composer require symfony/mailgun-mailer symfony/http-client
# MAILGUN_DOMAIN=mg.your-domain.com
# MAILGUN_SECRET=key-XXXX           # MUST be a "Private API key", not a Sending key or Webhook signing key
# MAILGUN_ENDPOINT=api.mailgun.net  # or api.eu.mailgun.net for the EU region
#
# *** IMPORTANT — IP ALLOWLIST GOTCHA ***
# If your Mailgun account has "Restrict API access by IP" enabled
# (Settings → API Security → API Allowlist), every API request from a
# non-allowlisted IP returns 401 Forbidden EVEN WITH A VALID KEY. Symptoms:
#   - direct curl test returns HTTP/2 401 with `www-authenticate: Basic realm="MG API"`
#   - storage/logs/laravel.log shows `Mailer [mailgun]: Forbidden (code 401)`
# Add the originating IP (your home/dev IP, your prod server's egress IP)
# to the allowlist or disable the feature. Home IPs rotate every ~30 days
# on most ISPs — expect to refresh the allowlist periodically.
#
# Make sure SPF + DKIM are set on the sending domain before going live —
# bounces from a fresh sender will tank deliverability fleet-wide.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CLOCKWORK_ARCJET_BOTS_URL=https://raw.githubusercontent.com/arcjet/well-known-bots/main/well-known-bots.json

CLOCKWORK_MATTERMOST_ENABLED=false
CLOCKWORK_MATTERMOST_WEBHOOK_URL=
CLOCKWORK_MATTERMOST_CHANNEL=
CLOCKWORK_MATTERMOST_USERNAME=Clockwork
CLOCKWORK_MATTERMOST_ICON_EMOJI=:lock:

# Slack — second, independent chat channel alongside Mattermost. Both can
# be active at once (each notifier no-ops on its own ENABLED flag). Generate
# a webhook at Your App → Incoming Webhooks in the Slack API dashboard.
CLOCKWORK_SLACK_ENABLED=false
CLOCKWORK_SLACK_WEBHOOK_URL=
CLOCKWORK_SLACK_CHANNEL=
CLOCKWORK_SLACK_USERNAME=Clockwork
CLOCKWORK_SLACK_ICON_EMOJI=:lock:

# Identifies whoever runs this instance — used in the uptime prober's
# User-Agent (sent to every monitored site on every probe), the
# client-facing Slack support link, and outbound client email footers.
# Leave blank for a generic default with no real contact info.
CLOCKWORK_OPERATOR_NAME="Clockwork operator"
CLOCKWORK_OPERATOR_CONTACT_EMAIL=
CLOCKWORK_OPERATOR_SUPPORT_URL=
CLOCKWORK_OPERATOR_WEBSITE_URL=

CLOCKWORK_DEFAULT_SSH_USER=deploy
CLOCKWORK_DEFAULT_SSH_PORT=22
CLOCKWORK_SSH_KEY_PATH=
CLOCKWORK_SSH_KEY_PASSPHRASE=
CLOCKWORK_SSH_CONNECT_TIMEOUT=10
CLOCKWORK_SSH_EXEC_TIMEOUT=30
# Short fsockopen probe before the real SSH handshake, so a deleted/
# firewalled server fails fast instead of hanging past max_execution_time.
CLOCKWORK_SSH_PREFLIGHT_TIMEOUT=2

CLOCKWORK_CPU_RED_THRESHOLD=90
CLOCKWORK_CPU_YELLOW_THRESHOLD=70
CLOCKWORK_MEM_YELLOW_THRESHOLD=80
CLOCKWORK_DISK_YELLOW_THRESHOLD=85
CLOCKWORK_METRICS_WINDOW_MINUTES=15
# Grace period after Let's Encrypt's scheduled renewal date before a site is
# flagged "renewal needed" — some hosts' renewal cron doesn't fire exactly
# at midnight on the renews date.
CLOCKWORK_SSL_RENEWAL_GRACE_HOURS=48
# Comma-separated substrings (case-insensitive) — a server whose name
# matches any of these is auto-flagged ignored on first import (behind a
# firewall, customer-managed, can't reach via SSH, etc). Manual changes
# after that are preserved.
CLOCKWORK_AUTO_IGNORE_PATTERNS=
# Every fleet server named "webNN.example.com"? Set this to ".example.com"
# and server display tables show "webNN" instead of the full FQDN. Blank
# (default) shows the full name unchanged.
CLOCKWORK_SERVER_DISPLAY_NAME_STRIP_SUFFIX=

CLOCKWORK_DIGITALOCEAN_TOKEN=
CLOCKWORK_DIGITALOCEAN_BASE_URL=https://api.digitalocean.com/v2
CLOCKWORK_DIGITALOCEAN_TIMEOUT=15

# Hetzner Cloud API. Generate a read-only token at
# https://console.hetzner.cloud → project → Security → API Tokens.
# Tokens are scoped to a single Hetzner project — if you have multiple
# Hetzner projects the importer only sees servers in this one.
# Verify with: php artisan clockwork:hetzner-test
CLOCKWORK_HETZNER_TOKEN=
CLOCKWORK_HETZNER_BASE_URL=https://api.hetzner.cloud/v1
CLOCKWORK_HETZNER_TIMEOUT=15

# Azure — third cloud provider, VM metrics via Azure Monitor. OAuth 2.0
# client-credentials flow — create a Service Principal with at minimum
# Reader access on the target subscription/resource group.
# Verify with: php artisan clockwork:azure-test
CLOCKWORK_AZURE_TENANT_ID=
CLOCKWORK_AZURE_CLIENT_ID=
CLOCKWORK_AZURE_CLIENT_SECRET=
CLOCKWORK_AZURE_SUBSCRIPTION_ID=
CLOCKWORK_AZURE_BASE_URL=https://management.azure.com
CLOCKWORK_AZURE_LOGIN_URL=https://login.microsoftonline.com
CLOCKWORK_AZURE_TIMEOUT=15

# Vultr Cloud API v2. Generate a read-only API key at
# https://my.vultr.com/settings/#settingsapi.
# Verify at /settings/diagnostics (Vultr API check).
CLOCKWORK_VULTR_API_KEY=
CLOCKWORK_VULTR_BASE_URL=https://api.vultr.com/v2
CLOCKWORK_VULTR_TIMEOUT=15

# Linode (Akamai) Cloud API v4. Generate a personal access token at
# https://cloud.linode.com/profile/tokens with read-only "Linodes" scope.
CLOCKWORK_LINODE_TOKEN=
CLOCKWORK_LINODE_BASE_URL=https://api.linode.com/v4
CLOCKWORK_LINODE_TIMEOUT=15

# Operator email for ops-side alerts (nightly auto-update summary,
# future fleet-wide health alerts). Per-customer notifications still go
# to the site's client_email — this is just for the operator to see it.
# Mailgun delivers; the IP allowlist gotcha applies.
CLOCKWORK_ALERTS_EMAIL=

# Twilio SMS for site-down / site-up alerts on care-plan sites. Recipients
# (named recipients) live in the notification_recipients DB table — see
# /settings/notifications. This block holds only the API credentials.
#
# To enable:
#   1. Sign up at https://twilio.com — copy the Account SID + Auth Token
#      from the Console dashboard.
#   2. Buy a US phone number with SMS capability (~$1/month).
#   3. *** A2P 10DLC ***: US business SMS now requires registering a
#      brand + campaign through Twilio's Console. ~$15 one-time + ~$1.50
#      monthly. Trial accounts can SMS verified numbers without it, but
#      production traffic to arbitrary numbers needs the registration
#      complete or messages get rejected with error 30034.
#   4. Set TWILIO_ENABLED=true to flip the SMS notifier on. Mattermost
#      keeps firing in parallel — this adds a channel, doesn't replace.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ENABLED=false

# DigitalOcean Spaces (S3-compatible) — Spaces Access Key, NOT the Personal Access Token.
# Verify with: php artisan clockwork:do-spaces-test
CLOCKWORK_DO_SPACES_KEY=
CLOCKWORK_DO_SPACES_SECRET=
CLOCKWORK_DO_SPACES_REGION=nyc3
CLOCKWORK_DO_SPACES_BUCKET=your-bucket-name
CLOCKWORK_DO_SPACES_PREFIX_TEMPLATE={domain}/

CLOCKWORK_SPINUPWP_TOKEN=
CLOCKWORK_SPINUPWP_BASE_URL=https://api.spinupwp.app/v1
CLOCKWORK_SPINUPWP_TIMEOUT=15
CLOCKWORK_SPINUPWP_VIEW_ONLY=false

CLOCKWORK_PRESSABLE_CLIENT_ID=
CLOCKWORK_PRESSABLE_CLIENT_SECRET=
CLOCKWORK_PRESSABLE_AUTH_URL=https://my.pressable.com/auth/token
CLOCKWORK_PRESSABLE_BASE_URL=https://my.pressable.com/v1
CLOCKWORK_PRESSABLE_TIMEOUT=15
CLOCKWORK_PRESSABLE_VIEW_ONLY=false

CLOCKWORK_WPENGINE_API_USER_ID=
CLOCKWORK_WPENGINE_API_PASSWORD=
CLOCKWORK_WPENGINE_BASE_URL=https://api.wpengine.com/v1
CLOCKWORK_WPENGINE_TIMEOUT=15
CLOCKWORK_WPENGINE_SSH_PRIVATE_KEY=
CLOCKWORK_WPENGINE_SSH_PRIVATE_KEY_PASSPHRASE=
CLOCKWORK_WPENGINE_VIEW_ONLY=true

CLOCKWORK_KINSTA_API_KEY=
CLOCKWORK_KINSTA_BASE_URL=https://api.kinsta.com/v2
CLOCKWORK_KINSTA_TIMEOUT=15
CLOCKWORK_KINSTA_SSH_PASSWORD=
CLOCKWORK_KINSTA_VIEW_ONLY=true

CLOCKWORK_CLOUDWAYS_API_KEY=
CLOCKWORK_CLOUDWAYS_EMAIL=
CLOCKWORK_CLOUDWAYS_BASE_URL=https://api.cloudways.com/api/v2
CLOCKWORK_CLOUDWAYS_TIMEOUT=15
CLOCKWORK_CLOUDWAYS_VIEW_ONLY=true

GRIDPANE_API_KEY=
GRIDPANE_BASE_URL=https://my.gridpane.com/oauth/api/v1
GRIDPANE_TIMEOUT=15
# View-only mode prevents any remote mutations (WP-CLI commands, SSH writes, Companion installs).
# Default is true for safe exploration with third-party or client API keys.
GRIDPANE_VIEW_ONLY=true

CLOCKWORK_CLOUDFLARE_API_TOKEN=
# Zone.DNS:Edit token, used only by the site-migration runner's cutover
# phase — separated from the read token above so a leak of that one can't
# mutate DNS. Leave blank if you don't run migrations through this app.
CLOCKWORK_CLOUDFLARE_WRITE_TOKEN=
CLOCKWORK_CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4
CLOCKWORK_CLOUDFLARE_TIMEOUT=15

# Backup Relay (Multi-Provider → S3 Glacier IR archiving).
# Mode: 'in_repo' (default native scheduler) or 'external_agent' (standalone droplet).
CLOCKWORK_BACKUP_RELAY_MODE=in_repo
CLOCKWORK_BACKUP_RELAY_FREQUENCY=weekly
CLOCKWORK_BACKUP_RELAY_RETENTION_DAYS=90
CLOCKWORK_BACKUP_RELAY_S3_PREFIX=
CLOCKWORK_BACKUP_RELAY_ARCHIVE_PREFIX=archives

# Dedicated S3 credentials for backup relay (falls back to AWS_* if unset)
S3_BACKUP_RELAY_KEY=
S3_BACKUP_RELAY_SECRET=
S3_BACKUP_RELAY_REGION=us-east-1
S3_BACKUP_RELAY_BUCKET=

CLOCKWORK_LM_STUDIO_BASE_URL=http://localhost:1234/v1
CLOCKWORK_LM_STUDIO_MODEL=meta-llama-3-8b-instruct
CLOCKWORK_LM_STUDIO_API_KEY=lm-studio
CLOCKWORK_LM_STUDIO_TIMEOUT=120

# Bill.com sync (read-only). Auto-links sites to customers + auto-flips
# care_plan_enabled. Generate dev_key at https://developer.bill.com/.
CLOCKWORK_BILL_COM_ENABLED=false
CLOCKWORK_BILL_COM_USERNAME=
CLOCKWORK_BILL_COM_PASSWORD=
CLOCKWORK_BILL_COM_ORG_ID=
CLOCKWORK_BILL_COM_DEV_KEY=
CLOCKWORK_BILL_COM_BASE_URL=https://api.bill.com/api/v2
CLOCKWORK_BILL_COM_TIMEOUT=30
# Regex an Invoice line-item description must match to count as a
# care-plan charge (case-insensitive).
CLOCKWORK_BILL_COM_CARE_PLAN_ITEM_REGEX="/care plan/i"
# How far back to look, in days, when linking a site to a Bill.com customer
# by domain/email match, and when deciding a care-plan invoice is recent
# enough to keep care_plan_enabled=true.
CLOCKWORK_BILL_COM_CUSTOMER_LINK_WINDOW_DAYS=1095
CLOCKWORK_BILL_COM_CARE_PLAN_WINDOW_DAYS=400

# Domain blacklist scanning (clockwork:check-blacklists). Spamhaus DBL is free
# and runs always. Both keys below are free registrations — leave blank to skip
# that source.
#   GSB key:     https://console.cloud.google.com/apis/credentials  (enable PageSpeed Insights API + Safe Browsing API)
#   URLHaus key: https://auth.abuse.ch/  (free account)
CLOCKWORK_GOOGLE_SAFE_BROWSING_KEY=
CLOCKWORK_URLHAUS_AUTH_KEY=
CLOCKWORK_BLACKLIST_TIMEOUT=10

# Sucuri SiteCheck (clockwork:scan-sitecheck) — anonymous public endpoint,
# no API key. Sucuri returns 403 to non-browser User-Agents but the host is
# up; treated as OK as long as the response is < 500.
CLOCKWORK_SUCURI_BASE_URL=https://sitecheck.sucuri.net
CLOCKWORK_SUCURI_TIMEOUT=30

# Companion mu-plugin distribution. Both blank = installer falls back to a
# local rsync from CLOCKWORK_COMPANION_LOCAL_PATH (dev mode) instead of
# downloading a packaged .zip.
CLOCKWORK_COMPANION_DIST_URL=
CLOCKWORK_COMPANION_DIST_SHA256=
CLOCKWORK_COMPANION_LOCAL_PATH=
CLOCKWORK_COMPANION_TIMEOUT=30
CLOCKWORK_COMPANION_TIMEOUT_MULTISITE=60
# The mu-plugin version bundled with this Core release. Bump when a new
# Companion tarball ships — drives the fleet rollout breakdown on
# /settings/updates.
CLOCKWORK_COMPANION_VERSION=1.33.0

# The installed Core version lives in config/clockwork.php, not here — it's
# which code is checked out, not install-specific config, so it must come
# from the code itself and update automatically on every git pull. There is
# deliberately no CLOCKWORK_VERSION env var to set.
CLOCKWORK_UPDATE_CHANNEL=stable
CLOCKWORK_UPDATE_REPO=Clockwork-Web-Dev-LLC/clockwork-control
# CLOCKWORK_UPDATES_API_URL=  # full override, only if the repo slug above isn't enough
CLOCKWORK_UPDATES_CACHE_TTL=43200

# Performance scans — primary engine: GTmetrix (since 2026-06-27)
# REST API v2. Pinned test location + browser version gives much lower
# day-over-day score variance than PSI's ±10-15 noise floor. Paid account
# required (free tier is 5 tests/day — won't cover a 50-site fleet run).
# Generate the API key at https://gtmetrix.com/dashboard/api/.
CLOCKWORK_GTMETRIX_API_KEY=
CLOCKWORK_GTMETRIX_BASE_URL=https://gtmetrix.com/api/2.0
# Default test location — GTmetrix v2 location ID (integer, NOT a slug).
# Per-site override lives on sites.performance_scan_region.
# Common: 2=London, 3=Sydney, 4=San Antonio TX, 7=Hong Kong, 9=San Francisco,
# 10=Cheyenne WY, 11=Chicago IL, 12=Danville VA, 24=Seattle, ... — full list:
# curl -u <key>: https://gtmetrix.com/api/2.0/locations | jq
CLOCKWORK_GTMETRIX_REGION=4
# Optional tuning: timeout per scan, polling cadence.
# CLOCKWORK_GTMETRIX_TIMEOUT=120
# CLOCKWORK_GTMETRIX_POLL_INTERVAL=5
# CLOCKWORK_GTMETRIX_POLL_MAX_ATTEMPTS=36

# Google PageSpeed Insights v5 — FALLBACK engine. Kept wired up for ~30
# days post-cutover so a transient GTmetrix outage doesn't lose a site's
# nightly data point. Will be retired after a clean GTmetrix-only window.
# Free, 25k req/day default quota. Enable "PageSpeed Insights API" in
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Leave blank to skip the fallback entirely.
CLOCKWORK_PSI_API_KEY=
CLOCKWORK_PSI_TIMEOUT=90

# Google OAuth — only identity provider for app login. Operator-controlled
# allowlist gating happens in the database (`users` table); these credentials
# just verify "is this person who they say they are."
#   1. Create OAuth 2.0 Client at https://console.cloud.google.com/apis/credentials
#      (type: Web application).
#   2. Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly. Multiple
#      URIs are allowed — register http://localhost:8000/auth/google/callback
#      for dev and your LAN hostname callback for the team.
#   3. GOOGLE_HD optionally pins to a Google Workspace domain (e.g. your-agency.com)
#      so users have to pick an account on that domain. Off by default so personal
#      accounts work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_HD=
