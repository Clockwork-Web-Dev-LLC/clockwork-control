# Loaded automatically when APP_ENV=testing (phpunit.xml sets this) —
# Laravel uses THIS file INSTEAD of .env entirely when it exists, not as an
# overlay, so every value the test suite needs has to be here explicitly.
#
# Purpose: make sure the test suite NEVER depends on whatever's in a
# developer's local .env — before this file existed, CLOCKWORK_MATTERMOST_ENABLED=true
# in local .env bled into every test run, and Http::fake() was the ONLY
# thing standing between the suite and a real webhook call. Every
# outbound-notification channel is explicitly disabled here; tests that
# need to verify dispatch behavior override these via config() and still
# use Http::fake() so no real request can ever reach out, even if this
# file is ever misconfigured.
#
# APP_KEY below is a dedicated test-only key — never used for anything but
# encrypting/decrypting the throwaway in-memory sqlite test DB, safe to
# commit. It is NOT the production key and must never become it.

APP_KEY=base64:PpV0sYePBa5SQ0yDw4SESwHn7nFlNfq4gKXdFjj5CjE=

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CLOCKWORK_MATTERMOST_ENABLED=false
CLOCKWORK_SLACK_ENABLED=false
TWILIO_ENABLED=false
CLOCKWORK_BILL_COM_ENABLED=false
