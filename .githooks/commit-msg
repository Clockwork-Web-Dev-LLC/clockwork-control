#!/usr/bin/env bash
# Commit-msg guard: blocks client domains, names, and emails in commit messages.

set -euo pipefail

MSG_FILE="$1"
DENYLIST="${HOME}/.config/clockwork/client-denylist.txt"

if [ -f "$DENYLIST" ] && [ -f "$MSG_FILE" ]; then
    matches="$(grep -v '^#' "$MSG_FILE" | grep -iE -f "$DENYLIST" || true)"
    if [ -n "$matches" ]; then
        echo "BLOCKED: commit message matches the client-identifier denylist (~/.config/clockwork/client-denylist.txt):" >&2
        echo "$matches" | head -20 >&2
        echo "  Anonymize the commit message before committing." >&2
        exit 1
    fi
fi

exit 0
