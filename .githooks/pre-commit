#!/usr/bin/env bash
# Pre-commit guard, added after a real incident (commit 1b4fc08, a vim swap
# file .env.swp accidentally committed and pushed — cleaned up 2026-09-02).
#
# Layers:
# 1. Blocks .env*, *.swp, *.swo filenames from being committed.
# 2. Blocks client-identifying names in staged content (via ~/.config/clockwork/client-denylist.txt).
# 3. Runs gitleaks against staged changes (using .gitleaks.toml).
# 4. Validates PHP formatting (Pint) on staged .php files.
# 5. Validates JS/TS formatting and types (Biome + tsc) on staged frontend files.
#
# One-time setup per clone: git config core.hooksPath .githooks

set -euo pipefail

# Layer 1: Block never-commit filename shapes (.env*, *.swp, *.swo)
blocked=0

while IFS= read -r -d '' file; do
    base="$(basename "$file")"
    case "$base" in
        .env.example|.env.testing)
            continue
            ;;
        .env|.env.*|*.swp|*.swo)
            echo "BLOCKED: '$file' matches a never-commit pattern (.env*, *.swp, *.swo)." >&2
            echo "  If this is genuinely safe to commit, rename it or use 'git commit --no-verify' deliberately." >&2
            blocked=1
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [ "$blocked" -eq 1 ]; then
    exit 1
fi

# Layer 2: Block client-identifying names/domains/emails in staged content.
DENYLIST="${HOME}/.config/clockwork/client-denylist.txt"
if command -v php >/dev/null 2>&1 && [ -f "artisan" ]; then
    php -r '
        $denylistPath = getenv("HOME") . "/.config/clockwork/client-denylist.txt";
        @mkdir(dirname($denylistPath), 0700, true);
        $existing = is_file($denylistPath)
            ? array_map("trim", file($denylistPath, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES))
            : [];
        try {
            $pdo = new PDO("mysql:host=127.0.0.1;port=3306;dbname=clockwork", "root", "", [PDO::ATTR_TIMEOUT => 1]);
            $safeDomains = ["example.com", "example.org", "example.net", "localhost", "clockworkwd.com", "clockworkwp.com", "turnkeywp.com", "pressable.com", "headlesstesting.mystagingwebsite.com"];
            $domains = $pdo->query("SELECT domain FROM sites WHERE domain IS NOT NULL")->fetchAll(PDO::FETCH_COLUMN);
            foreach ($domains as $d) {
                $d = strtolower(trim((string) $d));
                if ($d !== "" && !in_array($d, $safeDomains, true)) {
                    $existing[] = preg_quote($d, "/");
                }
            }
            $emails = $pdo->query("SELECT email FROM clients WHERE email IS NOT NULL")->fetchAll(PDO::FETCH_COLUMN);
            foreach ($emails as $e) {
                $e = strtolower(trim((string) $e));
                if ($e !== "" && !str_ends_with($e, "@example.com") && !str_ends_with($e, "@clockworkwd.com") && !str_ends_with($e, "@clockworkwp.com") && $e !== "aaron.reimann@gmail.com") {
                    $existing[] = preg_quote($e, "/");
                }
            }
            $safeNames = ["clockwork", "example", "test client"];
            $names = $pdo->query("SELECT name FROM clients WHERE name IS NOT NULL UNION SELECT company_name FROM clients WHERE company_name IS NOT NULL")->fetchAll(PDO::FETCH_COLUMN);
            foreach ($names as $n) {
                $n = trim((string) $n);
                if (strlen($n) >= 6 && (str_contains($n, " ") || str_contains($n, ".") || strlen($n) >= 9) && !in_array(strtolower($n), $safeNames, true)) {
                    $existing[] = preg_quote($n, "/");
                }
            }
            $all = array_values(array_unique(array_filter($existing)));
            sort($all);
            file_put_contents($denylistPath, implode("\n", $all) . "\n");
        } catch (Throwable $e) {
            // DB offline or unreachable; fall back to existing file on disk.
        }
    ' 2>/dev/null || true
fi
if [ -f "$DENYLIST" ]; then
    matches="$(git diff --cached --no-color --unified=0 --diff-filter=ACM \
        | grep '^+' | grep -v '^+++' \
        | grep -iE -f "$DENYLIST" || true)"
    if [ -n "$matches" ]; then
        echo "BLOCKED: staged changes match the client-identifier denylist (~/.config/clockwork/client-denylist.txt):" >&2
        echo "$matches" | head -20 >&2
        echo "  Anonymize the reference (e.g. 'example.com' / 'Acme Corp') before committing." >&2
        exit 1
    fi
fi

# Layer 3: Gitleaks scan for secrets
if command -v gitleaks >/dev/null 2>&1; then
    repo_root="$(git rev-parse --show-toplevel)"
    if ! gitleaks git --staged --no-banner --config "${repo_root}/.gitleaks.toml" "$repo_root"; then
        echo "BLOCKED: gitleaks found a likely secret in staged changes (see above)." >&2
        exit 1
    fi
else
    echo "WARNING: gitleaks not installed — skipping secret-content scan (filename check still ran). Install with: brew install gitleaks" >&2
fi

# Layer 4: Check staged PHP files with Pint
STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$' || true)
if [ -n "$STAGED_PHP" ]; then
    echo "🐘 Checking PHP formatting..."
    ./vendor/bin/pint --test || {
        echo "❌ Pint failed. Run 'composer format' or './vendor/bin/pint' to fix." >&2
        exit 1
    }
fi

# Layer 5: Check staged JS/TS/JSON files with Biome & TypeScript
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|ts|json)$' || true)
if [ -n "$STAGED_JS" ]; then
    echo "⚡ Checking JavaScript/TypeScript..."
    npm run lint || {
        echo "❌ Biome check failed. Run 'npm run lint:fix' or 'npm run format' to fix." >&2
        exit 1
    }
    npm run typecheck || {
        echo "❌ TypeScript check failed." >&2
        exit 1
    }
fi

exit 0
