#!/usr/bin/env bash
# Pre-commit guard, added after a real incident (commit 1b4fc08, a vim swap
# file .env.swp accidentally committed and pushed — cleaned up 2026-09-02).
#
# Two layers, deliberately: gitleaks' default ruleset alone would NOT have
# caught that leak (Laravel's APP_KEY=base64:... and this app's own token
# formats aren't in its default patterns — confirmed live during cleanup).
# So this hook first blocks the exact filename shape that caused the
# incident outright, then runs gitleaks (with .gitleaks.toml's app-specific
# rules layered on top of the defaults) as a second, broader net.
#
# One-time setup per clone: git config core.hooksPath .githooks

set -euo pipefail

blocked=0

while IFS= read -r -d '' file; do
    base="$(basename "$file")"
    case "$base" in
        .env.example|.env.testing)
            continue
            ;;
        .env|.env.*|*.swp|*.swo)
            echo "BLOCKED: '$file' matches a never-commit pattern (.env*, *.swp, *.swo)." >&2
            echo "  If this is genuinely safe to commit, rename it or use 'git commit --no-verify' deliberately." >&2
            blocked=1
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [ "$blocked" -eq 1 ]; then
    exit 1
fi

# Third layer: block client-identifying names in staged content. The pattern
# list lives OUTSIDE the repo on purpose — committing it would itself leak the
# names it exists to protect. One extended-regex fragment per line, matched
# case-insensitively against added lines only. Absent file = layer disabled.
DENYLIST="${HOME}/.config/clockwork/client-denylist.txt"
if [ -f "$DENYLIST" ]; then
    # NB: '+' is a literal in BRE, so these patterns stay un-escaped — BSD
    # grep rejects '\+' escapes ("repetition-operator operand invalid"), and
    # under '|| true' that failure would silently disable this whole layer.
    matches="$(git diff --cached --no-color --unified=0 --diff-filter=ACM \
        | grep '^+' | grep -v '^+++' \
        | grep -iE -f "$DENYLIST" || true)"
    if [ -n "$matches" ]; then
        echo "BLOCKED: staged changes match the client-identifier denylist (~/.config/clockwork/client-denylist.txt):" >&2
        echo "$matches" | head -20 >&2
        echo "  Anonymize the reference (e.g. 'a client site') before committing." >&2
        exit 1
    fi
fi

if command -v gitleaks >/dev/null 2>&1; then
    repo_root="$(git rev-parse --show-toplevel)"
    if ! gitleaks git --staged --no-banner --config "${repo_root}/.gitleaks.toml" "$repo_root"; then
        echo "BLOCKED: gitleaks found a likely secret in staged changes (see above)." >&2
        exit 1
    fi
else
    echo "WARNING: gitleaks not installed — skipping secret-content scan (filename check still ran). Install with: brew install gitleaks" >&2
fi

exit 0
