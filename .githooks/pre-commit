#!/usr/bin/env bash
# Pre-commit guard, added after a real incident (commit 1b4fc08, a vim swap
# file .env.swp accidentally committed and pushed — cleaned up 2026-09-02).
#
# Layers:
# 1. Blocks .env*, *.swp, *.swo filenames from being committed.
# 2. Blocks client-identifying names in staged content (via ~/.config/clockwork/client-denylist.txt).
# 3. Runs gitleaks against staged changes (using .gitleaks.toml).
# 4. Validates PHP formatting (Pint) on staged .php files.
# 5. Validates JS/TS formatting and types (Biome + tsc) on staged frontend files.
#
# One-time setup per clone: git config core.hooksPath .githooks

set -euo pipefail

# Layer 1: Block never-commit filename shapes (.env*, *.swp, *.swo)
blocked=0

while IFS= read -r -d '' file; do
    base="$(basename "$file")"
    case "$base" in
        .env.example|.env.testing)
            continue
            ;;
        .env|.env.*|*.swp|*.swo)
            echo "BLOCKED: '$file' matches a never-commit pattern (.env*, *.swp, *.swo)." >&2
            echo "  If this is genuinely safe to commit, rename it or use 'git commit --no-verify' deliberately." >&2
            blocked=1
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [ "$blocked" -eq 1 ]; then
    exit 1
fi

# Layer 2: Block client-identifying names in staged content.
DENYLIST="${HOME}/.config/clockwork/client-denylist.txt"
if [ -f "$DENYLIST" ]; then
    matches="$(git diff --cached --no-color --unified=0 --diff-filter=ACM \
        | grep '^+' | grep -v '^+++' \
        | grep -iE -f "$DENYLIST" || true)"
    if [ -n "$matches" ]; then
        echo "BLOCKED: staged changes match the client-identifier denylist (~/.config/clockwork/client-denylist.txt):" >&2
        echo "$matches" | head -20 >&2
        echo "  Anonymize the reference (e.g. 'a client site') before committing." >&2
        exit 1
    fi
fi

# Layer 3: Gitleaks scan for secrets
if command -v gitleaks >/dev/null 2>&1; then
    repo_root="$(git rev-parse --show-toplevel)"
    if ! gitleaks git --staged --no-banner --config "${repo_root}/.gitleaks.toml" "$repo_root"; then
        echo "BLOCKED: gitleaks found a likely secret in staged changes (see above)." >&2
        exit 1
    fi
else
    echo "WARNING: gitleaks not installed — skipping secret-content scan (filename check still ran). Install with: brew install gitleaks" >&2
fi

# Layer 4: Check staged PHP files with Pint
STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$' || true)
if [ -n "$STAGED_PHP" ]; then
    echo "🐘 Checking PHP formatting..."
    ./vendor/bin/pint --test || {
        echo "❌ Pint failed. Run 'composer format' or './vendor/bin/pint' to fix." >&2
        exit 1
    }
fi

# Layer 5: Check staged JS/TS/JSON files with Biome & TypeScript
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|ts|json)$' || true)
if [ -n "$STAGED_JS" ]; then
    echo "⚡ Checking JavaScript/TypeScript..."
    npm run lint || {
        echo "❌ Biome check failed. Run 'npm run lint:fix' or 'npm run format' to fix." >&2
        exit 1
    }
    npm run typecheck || {
        echo "❌ TypeScript check failed." >&2
        exit 1
    }
fi

exit 0
