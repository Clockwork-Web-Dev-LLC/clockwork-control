    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "clockwork/core": "@dev",
        "laravel/mcp": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Mcp\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Mcp\\McpModuleServiceProvider"
            ]
        }
    }
}
